# Copy to .env.bootstrap (gitignored) and fill in. Used ONLY by
# `npm run bootstrap` -- a one-time script that creates the first household
# and its first Parent login on a fresh Supabase project.
# See docs/DEPLOYMENT_RUNBOOK.md. Never commit the real file.

SUPABASE_URL=https://fsszkclgeekdyyspgrhg.supabase.co
# Supabase dashboard -> Project Settings -> API Keys -> "service_role" /
# secret key. Full-access key: keep it out of git, chat and the browser.
SUPABASE_SERVICE_ROLE_KEY=

FIRST_PARENT_EMAIL=
FIRST_PARENT_PASSWORD=
FIRST_PARENT_NAME=
HOUSEHOLD_NAME=
# IANA zone name, e.g. America/New_York, America/Chicago, America/Los_Angeles
HOUSEHOLD_TIMEZONE=America/New_York
