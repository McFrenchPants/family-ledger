# Copy to .env and fill in. .env is gitignored -- never commit real values.
# See docs/ARCHITECTURE.md S16/S20/S21 and CLAUDE.md for what each is and
# which are safe for the browser bundle (VITE_-prefixed only).

# Public -- safe to expose in the browser bundle.
VITE_SUPABASE_URL=https://fsszkclgeekdyyspgrhg.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_VAPID_PUBLIC_KEY=

# Secret -- Supabase Edge Function environment only. NEVER give these a
# VITE_ prefix, NEVER put them in this file with a real value, NEVER commit
# them. Set them via `npx supabase secrets set` against the linked project,
# not in a .env file that ships anywhere near the frontend build.
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=

# Local development -- point VITE_SUPABASE_URL/ANON_KEY at the Docker stack
# (`npx supabase start`) instead of the hosted project. `npx supabase status`
# prints the values; the local anon key is Supabase's fixed demo key, so it is
# safe to paste into your own .env (which stays gitignored).
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<ANON_KEY from `npx supabase status`>
